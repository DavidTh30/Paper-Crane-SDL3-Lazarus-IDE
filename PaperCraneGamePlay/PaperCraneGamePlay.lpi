<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Paper Crane"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Release" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="SDL3_package"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="PaperCraneGamePlay.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="ugamescene.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uGameScene"/>
      </Unit>
      <Unit>
        <Filename Value="urenderpool.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uRenderPool"/>
      </Unit>
      <Unit>
        <Filename Value="uframerenderer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uFrameRenderer"/>
      </Unit>
      <Unit>
        <Filename Value="usdlview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uSDLView"/>
      </Unit>
      <Unit>
        <Filename Value="uaudio.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uAudio"/>
      </Unit>
      <Unit>
        <Filename Value="usvgrecorder.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uSvgRecorder"/>
      </Unit>
      <Unit>
        <Filename Value="uplayer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uPlayer"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="PaperCraneGamePlay"/>
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value="../PaperCrane Shared"/>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <SmartLinkUnit Value="True"/>
      <Optimizations>
        <OptimizationLevel Value="3"/>
      </Optimizations>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <GenerateDebugInfo Value="False"/>
        <RunWithoutDebug Value="True"/>
      </Debugging>
      <LinkSmart Value="True"/>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-CpCOREAVX2 -OpCOREAVX2 -CfAVX2 -OoFASTMATH -OoLOOPUNROLL -Si"/>
    </Other>
  </CompilerOptions>
</CONFIG>
